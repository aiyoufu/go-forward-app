  static readonly CONSENT_VERSION: number = 1
  static readonly PREF_CONSENT_VERSION: string = 'legal_consent_version'

  static title(kind: LegalDocKind): string {
    return kind === 'privacy' ? '隐私政策' : '用户协议'
  }

  static body(kind: LegalDocKind): string {
    return kind === 'privacy' ? LegalDocuments.privacyBody() : LegalDocuments.termsBody()
  }

